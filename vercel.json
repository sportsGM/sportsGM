{
  "version": 2,
  "functions": {
    "api/games.js": {
      "maxDuration": 10
    },
    "api/analyze.js": {
      "maxDuration": 10
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/comments.js": {
      "maxDuration": 10
    },
    "api/reactions.js": {
      "maxDuration": 10
    },
    "api/pundits.js": {
      "maxDuration": 10
    },
    "api/admin.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/games",
      "dest": "/api/games.js"
    },
    {
      "src": "/api/analyze",
      "dest": "/api/analyze.js"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/comments",
      "dest": "/api/comments.js"
    },
    {
      "src": "/api/reactions",
      "dest": "/api/reactions.js"
    },
    {
      "src": "/api/pundits",
      "dest": "/api/pundits.js"
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.js"
    },
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}